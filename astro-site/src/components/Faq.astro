---
import { faqs } from '../site.config';
---
<section class="section section--tight" style="background:#f3ede3">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Before you ask</p>
      <h2>Frequently asked questions</h2>
    </div>
    <div class="faq">
      {faqs.map((f) => (
        <details class="reveal">
          <summary>{f.q}</summary>
          <div class="answer"><p>{f.a}</p></div>
        </details>
      ))}
    </div>
  </div>
</section>
