---
import { site, path } from '../site.config';
const a = site.admission;
---
<aside class="urgency" id="urgencyBar" aria-label="Admission announcement">
  <div class="wrap urgency__inner">
    <span class="dot" aria-hidden="true"></span>
    <span>New <b>{a.batchName}</b> batch starts <b>{a.startDate}</b> &middot; only
      <b>{a.seatsLeft} of {a.seatsTotal} seats</b> left &middot;
      <a href={path("/#enquiry")}>Reserve your seat &rarr;</a></span>
    <button class="urgency__close" id="urgencyClose" type="button" aria-label="Dismiss this announcement">&times;</button>
  </div>
</aside>
