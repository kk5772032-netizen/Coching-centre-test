---
import { site } from '../site.config';
import Icon from './Icon.astro';
const mapQuery = encodeURIComponent(`${site.address.street}, ${site.address.locality} ${site.address.postalCode}`);
---
<section class="section" id="contact">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">Visit us</p>
      <h2>Where we are</h2>
    </div>

    <div class="loc">
      <div class="reveal">
        <div class="metro">
          <Icon name="metro" size={26} />
          <span>
            <b>{site.metroWalkMinutes} minutes from {site.metro}</b>
            <span>Yellow Line. Come out of Gate 3, walk straight towards Batra Cinema — we are above Punjab National Bank.</span>
          </span>
        </div>

        <ul class="info">
          <li><Icon name="pin" size={20} /><span><b>Address</b>{site.address.line1},<br />{site.address.line2}</span></li>
          <li><Icon name="clock" size={20} /><span><b>Office timings</b>{site.timings}<br />{site.sundayTimings}</span></li>
          <li><Icon name="phone" size={20} /><span><b>Phone &amp; WhatsApp</b><a href={`tel:${site.phone}`}>+91 {site.phoneDisplay}</a></span></li>
          <li><Icon name="mail" size={20} /><span><b>Email</b><a href={`mailto:${site.email}`}>{site.email}</a></span></li>
        </ul>

        <a class="btn btn--outline" href={`https://www.google.com/maps/dir/?api=1&destination=${mapQuery}`} target="_blank" rel="noopener">
          <Icon name="send" size={19} />
          Get Directions
        </a>
      </div>

      <!-- Facade: Google's embed is several hundred KB, so it only loads when
           asked. The address and directions link above are the real content. -->
      <div class="map reveal" id="mapHolder" data-src={`https://www.google.com/maps?q=${mapQuery}&output=embed`}>
        <button class="map__load" type="button" id="mapLoad">
          <svg viewBox="0 0 400 300" class="map__art" aria-hidden="true">
            <rect width="400" height="300" fill="#e8eadf"/>
            <g stroke="#cdd2c2" stroke-width="10" fill="none"><path d="M-10 70h420M-10 210h420M90 -10v320M290 -10v320"/></g>
            <g stroke="#fff" stroke-width="4" fill="none"><path d="M-10 70h420M-10 210h420M90 -10v320M290 -10v320"/></g>
            <rect x="16" y="88" width="58" height="46" fill="#dbe0d0"/>
            <rect x="112" y="92" width="70" height="40" fill="#dbe0d0"/>
            <rect x="210" y="96" width="62" height="38" fill="#dbe0d0"/>
            <rect x="312" y="88" width="70" height="48" fill="#dbe0d0"/>
            <rect x="24" y="230" width="52" height="44" fill="#dbe0d0"/>
            <rect x="128" y="234" width="120" height="40" fill="#dbe0d0"/>
            <rect x="300" y="228" width="70" height="46" fill="#dbe0d0"/>
            <path d="M200 118c-13 0-24 11-24 24 0 18 24 44 24 44s24-26 24-44c0-13-11-24-24-24z" fill="#6d1f28"/>
            <circle cx="200" cy="141" r="8.5" fill="#fff"/>
          </svg>
          <span class="map__cta">
            <Icon name="pin" size={20} />
            Load the map
          </span>
          <span class="map__note">Loads Google Maps &middot; uses extra data</span>
        </button>
        <noscript>
          <a class="btn btn--outline btn--block" style="margin:16px"
             href={`https://www.google.com/maps/dir/?api=1&destination=${mapQuery}`}
             target="_blank" rel="noopener">Open in Google Maps</a>
        </noscript>
      </div>
    </div>
  </div>
</section>

<script>
  const holder = document.getElementById('mapHolder');
  document.getElementById('mapLoad')?.addEventListener('click', () => {
    if (!holder) return;
    const frame = document.createElement('iframe');
    frame.title = 'Map showing the institute location';
    frame.src = holder.getAttribute('data-src')!;
    frame.loading = 'lazy';
    frame.referrerPolicy = 'no-referrer-when-downgrade';
    holder.innerHTML = '';
    holder.appendChild(frame);
    window.track?.('map_load', {});
  });
</script>
