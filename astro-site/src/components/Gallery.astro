---
<section class="section section--tight gallery" id="centre">
  <div class="wrap">
    <div class="section-head reveal">
      <p class="eyebrow">See it before you come</p>
      <h2>Inside the centre</h2>
      <p class="lede">Two floors on Outram Lines — five classrooms, a reading room open till 9 PM, and a separate test hall. Walk in any working day and see it yourself.</p>
    </div>
  </div>

  <ul class="gallery__strip reveal" id="galleryRow">
    {gallery.map((item) => (
      <li>
        <figure>
          <Fragment set:html={scenes[item.scene]} />
          <figcaption><b>{item.title}</b>{item.body}</figcaption>
        </figure>
      </li>
    ))}
  </ul>

  <div class="wrap">
    <RowNav target="#galleryRow" label="gallery" />
    <p class="gallery__note reveal">Illustrations shown above are placeholders. Replace them with photographs of the actual centre before going live.</p>
  </div>
</section>
