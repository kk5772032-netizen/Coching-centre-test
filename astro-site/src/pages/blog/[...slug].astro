---
import { getCollection, render } from 'astro:content';
import type { GetStaticPaths } from 'astro';
import { site, path } from '../../site.config';
import Base from '../../layouts/Base.astro';

export const getStaticPaths: GetStaticPaths = async () => {
  const posts = await getCollection('posts', ({ data }) => !data.draft);
  return posts.map((post) => ({ params: { slug: post.id }, props: { post } }));
};

const { post } = Astro.props;
const { Content } = await render(post);
const fmt = post.data.date.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });

const schema = {
  '@context': 'https://schema.org',
  '@type': 'BlogPosting',
  headline: post.data.title,
  description: post.data.description,
  datePublished: post.data.date.toISOString(),
  author: { '@type': 'Organization', name: site.name },
  publisher: { '@type': 'Organization', name: site.name },
};
---
<Base title={`${post.data.title} | ${site.name}`} description={post.data.description} schema={schema}>
  <section class="hero hero--course">
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb">
        <a href={path("/")}>Home</a> <span aria-hidden="true">/</span>
        <a href={path("/blog/")}>Blog</a> <span aria-hidden="true">/</span>
        <span aria-current="page">{post.data.tag}</span>
      </nav>
      <h1>{post.data.title}</h1>
      <p class="hero__tag">{post.data.description}</p>
      <p class="post-card__date" style="color:#9fb2c6">
        <time datetime={post.data.date.toISOString()}>{fmt}</time>
      </p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <article class="prose prose--single">
        <Content />
      </article>

      <aside class="post-cta">
        <h2>Preparing for this exam?</h2>
        <p>Sit in a free demo class at our {site.area} centre before you decide anything. Two classes, no advance payment.</p>
        <a class="btn btn--primary" href={path("/#enquiry")}>Book a free demo class</a>
      </aside>
    </div>
  </section>
</Base>
