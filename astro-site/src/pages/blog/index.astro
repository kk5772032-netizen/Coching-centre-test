---
import { getCollection } from 'astro:content';
import { site } from '../../site.config';
import Base from '../../layouts/Base.astro';

const posts = (await getCollection('posts', ({ data }) => !data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());

const fmt = (d: Date) => d.toLocaleDateString('en-IN', { day: 'numeric', month: 'long', year: 'numeric' });
---
<Base
  title={`SSC exam updates & preparation guides | ${site.name}`}
  description={`Notifications, cut-offs and preparation guides for SSC CGL, CHSL and Delhi Police, written by the faculty at ${site.name}, ${site.area}, Delhi.`}
>
  <section class="hero hero--course">
    <div class="wrap">
      <p class="hero__since">Blog</p>
      <h1>Exam updates &amp; preparation guides</h1>
      <p class="hero__tag">Notifications, cut-offs and study advice, written by the people who teach the batches. Updated as the SSC calendar moves.</p>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <div class="post-list">
        {posts.map((post) => (
          <article class="post-card reveal">
            <p class="post-card__tag">{post.data.tag}</p>
            <h2><a href={`/blog/${post.id}/`}>{post.data.title}</a></h2>
            <p class="post-card__desc">{post.data.description}</p>
            <p class="post-card__date"><time datetime={post.data.date.toISOString()}>{fmt(post.data.date)}</time></p>
          </article>
        ))}
      </div>
    </div>
  </section>
</Base>
